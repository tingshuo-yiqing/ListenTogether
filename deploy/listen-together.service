[Unit]
Description=ListenTogether room server
After=network.target

[Service]
Type=simple
User=listen
Group=listen
WorkingDirectory=/opt/listen-together/server
EnvironmentFile=/etc/listen-together.env
ExecStart=/usr/bin/node /opt/listen-together/server/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
